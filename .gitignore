# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Local env files
.env
.env.*

# Logs
*.log

# Runtime thumbnail cache (MACATTACK_DATA_DIR default). Keep the folder
# itself (.gitkeep) so a cloned/copied project already has data/thumbnails
# for the docker-compose bind mount; ignore everything written into it.
data/thumbnails/*
!data/thumbnails/.gitkeep

# OS / editor clutter
.DS_Store
*.tsbuildinfo
